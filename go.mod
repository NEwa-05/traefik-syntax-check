// The following directives mirror the ones of github.com/traefik/traefik/v3,
// as replace directives of dependencies are not applied to dependent modules.
// Keep them in sync when upgrading Traefik.

// github.com/traefik/traefik/dynamic/ext is a nested module of the Traefik repository,
// which is not published: a copy of its v3.7.1 sources lives in third_party.
replace github.com/traefik/traefik/dynamic/ext => ./third_party/traefik-dynamic-ext

// Containous forks
replace (
	github.com/abbot/go-http-auth => github.com/containous/go-http-auth v0.4.1-0.20200324110947-a37a7636d23e
	github.com/gorilla/mux => github.com/containous/mux v0.0.0-20250523120546-41b6ec3aed59
	github.com/mailgun/minheap => github.com/containous/minheap v0.0.0-20190809180810-6e71eb837595
)

// ambiguous import: found package github.com/tencentcloud/tencentcloud-sdk-go/tencentcloud/common/http in multiple modules
exclude github.com/tencentcloud/tencentcloud-sdk-go v3.0.83+incompatible
